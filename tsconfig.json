{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2025"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.ts"
  ]
}
