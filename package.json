{
  "name": "vitest-vscode-runner",
  "version": "0.0.9",
  "license": "MIT",
  "private": false,
  "type": "module",
  "description": "Vitest plugin for running VS Code extension tests inside the extension host.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vscode/test-electron": "^3.0.0",
    "devalue": "^5.8.1"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.120.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:sample-extension": "vitest run --root tests/sample-extension"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
