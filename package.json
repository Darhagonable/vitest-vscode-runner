{
  "name": "vitest-vscode-runner",
  "version": "0.0.9",
  "private": false,
  "type": "module",
  "description": "Vitest plugin for running VS Code extension tests inside the extension host.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@vscode/test-electron": "^3.0.0",
    "devalue": "^5.8.1"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.120.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/sample-extension/tsconfig.json",
    "test": "vitest run",
    "test:sample-extension": "vitest run --root tests/sample-extension"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
